# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local / .env. Secret production disimpan di Vercel.

# --- Database (PostgreSQL) ---
# Lokal: postgresql://USER@localhost:5432/web_atlit_dev?schema=public
# Produksi (Supabase): transaction pooler port 6543. Lihat doc/DEPLOYMENT.md.
DATABASE_URL=
# Produksi saja: session pooler port 5432, dipakai `prisma migrate deploy`.
# DIRECT_URL=
# Produksi saja: sertifikat CA Supabase (PEM) untuk TLS terverifikasi.
# DATABASE_CA_CERT=

# Password untuk semua akun demo hasil seed (hanya development, minimal 8 karakter).
SEED_PASSWORD=

# Opsional: database untuk integration & E2E test (nama wajib berakhiran _test).
# Default: DATABASE_URL dengan nama database + "_test".
# TEST_DATABASE_URL=

# --- Better Auth (Phase 2) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL aplikasi, contoh lokal: http://localhost:3000
BETTER_AUTH_URL=

# --- Supabase Storage (Phase 10: PDF event, foto) ---
# Project Settings → API. Hanya dipakai di server: JANGAN beri prefix NEXT_PUBLIC_.
# Setelah diisi, jalankan `pnpm storage:setup` untuk membuat bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
