# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local / .env. Secret production disimpan di Vercel.

# --- Database (PostgreSQL) ---
# Lokal: postgresql://USER@localhost:5432/web_atlit_dev?schema=public
DATABASE_URL=

# --- Better Auth (Phase 2) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL aplikasi, contoh lokal: http://localhost:3000
BETTER_AUTH_URL=

# --- Storage (Phase 10: PDF event, avatar, gallery) ---
STORAGE_URL=
STORAGE_SERVICE_KEY=
STORAGE_PUBLIC_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private-docs
