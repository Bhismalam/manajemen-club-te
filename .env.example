# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local / .env. Secret production disimpan di Vercel.

# --- Database (PostgreSQL) ---
# Lokal: postgresql://USER@localhost:5432/web_atlit_dev?schema=public
DATABASE_URL=

# Password untuk semua akun demo hasil seed (hanya development, minimal 8 karakter).
SEED_PASSWORD=

# --- Better Auth (Phase 2) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL aplikasi, contoh lokal: http://localhost:3000
BETTER_AUTH_URL=

# --- Supabase Storage (Phase 10: PDF event, foto) ---
# Project Settings → API. Hanya dipakai di server: JANGAN beri prefix NEXT_PUBLIC_.
# Setelah diisi, jalankan `pnpm storage:setup` untuk membuat bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
